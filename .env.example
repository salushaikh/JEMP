# -------------------------------------------------------------
# JOBLESS EMPIRE — ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------

# APPLICATION_EMAIL_TO: Destination inbox for received applications.
# Default: salehasshaikh82@gmail.com
APPLICATION_EMAIL_TO=salehasshaikh82@gmail.com

# -------------------------------------------------------------
# OPTION 1 (RECOMMENDED): HTTPS REST EMAIL APIS (Port 443)
# Completely immune to cloud container SMTP port timeouts / restrictions.
# -------------------------------------------------------------

# Resend (https://resend.com - Free tier: 3,000 emails/mo)
# Just sign up, grab your API key, and paste below:
RESEND_API_KEY=

# Or SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=notifications@joblessempire.com

# Or Discord/Slack/Zapier Webhook:
# Receive instant ping notifications whenever someone submits their application!
APPLICATION_WEBHOOK_URL=

# -------------------------------------------------------------
# OPTION 2: SMTP CONFIGURATION (e.g. Gmail, Custom Mail Server)
# -------------------------------------------------------------
# If using Gmail:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=your_gmail@gmail.com
#   SMTP_PASS=your_16_char_app_password
#   (Create at: https://myaccount.google.com/apppasswords)

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Jobless Empire Admissions <notifications@joblessempire.com>"

# -------------------------------------------------------------
# PLATFORM & AI SETTINGS
# -------------------------------------------------------------
GEMINI_API_KEY=
APP_URL=
